# ====================================
# JobTracker Backend - Variables d'Environnement
# ====================================
# Copiez ce fichier vers .env et remplissez les valeurs

# ------------------------------------
# BASE DE DONNÉES MONGODB
# ------------------------------------
# URL de connexion MongoDB (obligatoire)
MONGO_URL=mongodb://localhost:27017

# Nom de la base de données (obligatoire)
DB_NAME=jobtracker

# ------------------------------------
# SÉCURITÉ & AUTHENTIFICATION
# ------------------------------------
# Clé secrète pour signer les tokens JWT (obligatoire)
# Générez une clé sécurisée: openssl rand -hex 32
# Environnement : production (défaut, strict) | development | test
# En production, JWT_SECRET et SECRET_KEY sont OBLIGATOIRES, aléatoires, >= 32 caractères et différents.
# En development/test, s'ils sont vides, un secret éphémère est généré à chaque démarrage.
APP_ENV=development
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Origins autorisés pour CORS (optionnel, défaut: *)
CORS_ORIGINS=*

# ------------------------------------
# INTELLIGENCE ARTIFICIELLE
# ------------------------------------
# ⚠️ CHOISISSEZ UN MODE :

# === MODE 1: Plateforme Emergent ===
# (Utilisé automatiquement si emergentintegrations est installé)
# Clé universelle pour Gemini & GPT via la plateforme Emergent
# EMERGENT_LLM_KEY=sk-emergent-xxxxxxxxxxxxxxxx

# === MODE 2: Local avec SDKs Standards ===
# (Utilisé si emergentintegrations n'est PAS installé)
# Installez d'abord: pip install openai google-generativeai

# Clé Google AI pour Gemini (Conseiller Carrière)
# Obtenez-la sur: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...

# Clé OpenAI pour GPT-4o (Chatbot)
# Obtenez-la sur: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ------------------------------------
# GOOGLE OAUTH
# ------------------------------------
# Clé client Google pour l'authentification OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Secret client Google pour l'authentification OAuth
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Clé secrète pour les sessions (utilisée par exemple pour Flask sessions)
# Générer une valeur DIFFÉRENTE de JWT_SECRET (même commande)
SECRET_KEY=

# ------------------------------------
# VEILLE CHATGPT (Lot 2, optionnel : valeurs par défaut sûres)
# ------------------------------------
# WATCH_MAX_PER_RUN=20                 # créations max par exécution (1-20)
# WATCH_DAILY_CREATE_QUOTA=40          # créations max par jour de Paris et par utilisateur
# WATCH_RUN_WINDOW_PAST_HOURS=6        # ancienneté max d'une NOUVELLE exécution
# WATCH_RUN_RESUME_HOURS=24            # ancienneté max d'une REPRISE d'exécution
# WATCH_RUN_WINDOW_FUTURE_MINUTES=15   # avance max tolérée (décalage d'horloge)
# WATCH_ITEM_STALE_SECONDS=60          # délai avant reprise d'un élément interrompu

# ------------------------------------
# MCP (Lot 2, optionnel) : désactivé par défaut. En production Vercel : MCP_ENABLED ET
# MCP_PRODUCTION_ALLOWED, puis ouverture explicite de l'interrupteur d'urgence (fermé par défaut)
# ------------------------------------
# MCP_ENABLED=false
# MCP_PRODUCTION_ALLOWED=false          # production Vercel : seconde clé obligatoire
# MCP_ALLOWED_HOSTS=jobtracker.maadec.com
# OAuth du connecteur MCP (actif seulement si le MCP l'est) : valeurs par défaut de la spécification
# OAUTH_ISSUER=https://jobtracker.maadec.com
# OAUTH_ACCESS_TTL_SECONDS=3600          # accès : 1 h
# OAUTH_REFRESH_TTL_SECONDS=2592000       # refresh glissant : 30 jours
# OAUTH_GRANT_MAX_SECONDS=7776000         # durée absolue : 90 jours

# ------------------------------------
# MODE DEBUG (optionnel)
# ------------------------------------
DEBUG=false
