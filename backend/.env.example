# JobTracker Backend — exemple local uniquement
# Copier vers .env et remplacer les valeurs selon le besoin. Ne jamais committer .env.

# MongoDB (obligatoire)
MONGO_URL=mongodb://localhost:27017
DB_NAME=jobtracker

# Environnement et signatures
# development/test permettent des secrets éphémères; production exige deux secrets forts et différents.
APP_ENV=development
JWT_SECRET=
SECRET_KEY=
# Algorithme JWT (HS256) et durée d'accès (7 jours) sont fixés dans le code.

# URL/CORS
BACKEND_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Connexion Google et Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Fournisseurs IA. GOOGLE_API_KEY/GEMINI_API_KEY sont des alias encore lus par certaines routes.
GOOGLE_AI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Chiffrement des clés IA des utilisateurs (conserver la même clé pour relire les données chiffrées)
ENCRYPTION_KEY=

# Téléversement de documents via Cloudinary (facultatif)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mail de support (facultatif)
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD_APP=
SMTP_FROM_NAME=JobTracker Support
SMTP_FROM_EMAIL=
SUPPORT_EMAIL=contact@maadec.com
# SMTP_PASSWORD est une ancienne variable non utilisée par la version actuelle; utiliser SMTP_PASSWORD_APP.

# Notifications Push (facultatif)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=contact@maadec.com

# Quotas des jetons d'agents (valeurs par défaut indiquées)
AGENT_RATE_LIMIT=30/minute
AGENT_DAILY_CREATE_QUOTA=500
AGENT_MAX_ACTIVE_TOKENS=10
AGENT_LAST_USED_THROTTLE_SECONDS=300

# Veille (valeurs par défaut; les bornes sont validées au démarrage)
WATCH_MAX_PER_RUN=20
WATCH_DAILY_CREATE_QUOTA=40
WATCH_RUN_WINDOW_PAST_HOURS=6
WATCH_RUN_RESUME_HOURS=24
WATCH_RUN_WINDOW_FUTURE_MINUTES=15
WATCH_ITEM_STALE_SECONDS=60

# MCP/OAuth : désactivé par défaut; en production, garder les valeurs d'exploitation voulues.
MCP_ENABLED=false
MCP_PRODUCTION_ALLOWED=false
MCP_ALLOWED_HOSTS=jobtracker.maadec.com
MCP_RATE_LIMIT_PER_MINUTE=30
OAUTH_ISSUER=https://jobtracker.maadec.com
OAUTH_ACCESS_TTL_SECONDS=3600
OAUTH_REFRESH_TTL_SECONDS=2592000
OAUTH_GRANT_MAX_SECONDS=7776000
OAUTH_CODE_TTL_SECONDS=60
OAUTH_REQUEST_TTL_SECONDS=600
OAUTH_REFRESH_REUSE_GRACE_SECONDS=30
OAUTH_RATE_LIMIT=10/minute

DEBUG=false
