# JobTracker self-hosted production — modèle sans secrets
# Copier sur le serveur vers .env.production (permissions 600). Garder ce fichier local au VPS.
# Reprendre les valeurs de production actuelles : MONGO_URL, DB_NAME, JWT_SECRET,
# SECRET_KEY et ENCRYPTION_KEY doivent rester compatibles avec les données/sessions existantes.
APP_ENV=production
MONGO_URL=
DB_NAME=
JWT_SECRET=
SECRET_KEY=
ENCRYPTION_KEY=
CORS_ORIGINS=https://jobtracker.maadec.com
BACKEND_URL=https://jobtracker.maadec.com
FRONTEND_URL=https://jobtracker.maadec.com

# Google OAuth et Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Fournisseurs IA (GOOGLE_API_KEY et GEMINI_API_KEY sont des alias utilisés par des routes existantes)
GOOGLE_AI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# E-mail et fichiers
SMTP_HOST=smtppro.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD_APP=
SMTP_FROM_NAME=JobTracker Support
SMTP_FROM_EMAIL=
SUPPORT_EMAIL=contact@maadec.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notifications Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=contact@maadec.com

# MCP/OAuth : recopier l'état réel de la production actuelle, ces options sont indépendantes du déploiement web.
MCP_ENABLED=false
MCP_PRODUCTION_ALLOWED=false
MCP_ALLOWED_HOSTS=jobtracker.maadec.com
MCP_RATE_LIMIT_PER_MINUTE=30
OAUTH_ISSUER=https://jobtracker.maadec.com
OAUTH_ACCESS_TTL_SECONDS=3600
OAUTH_REFRESH_TTL_SECONDS=2592000
OAUTH_GRANT_MAX_SECONDS=7776000
OAUTH_CODE_TTL_SECONDS=60
OAUTH_REQUEST_TTL_SECONDS=600
OAUTH_REFRESH_REUSE_GRACE_SECONDS=30
OAUTH_RATE_LIMIT=10/minute

# Limites applicatives (facultatif; valeurs par défaut ci-dessous)
AGENT_RATE_LIMIT=30/minute
AGENT_DAILY_CREATE_QUOTA=500
AGENT_MAX_ACTIVE_TOKENS=10
AGENT_LAST_USED_THROTTLE_SECONDS=300
WATCH_MAX_PER_RUN=20
WATCH_DAILY_CREATE_QUOTA=40
WATCH_RUN_WINDOW_PAST_HOURS=6
WATCH_RUN_RESUME_HOURS=24
WATCH_RUN_WINDOW_FUTURE_MINUTES=15
WATCH_ITEM_STALE_SECONDS=60
DEBUG=false
