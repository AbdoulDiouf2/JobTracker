+"""
+JobTracker SaaS - Identifiants des modèles Google Gemini
+
+Source unique des modèles Gemini utilisés par le backend. Les modèles Gemini 1.5 et 2.0
+ont été arrêtés par Google (2.0 : 1er juin 2026) : tout identifiant retiré, y compris
+envoyé par un client ou mémorisé côté navigateur, est redirigé vers un modèle actuel.
+
+Modèles surchargeables par variables d'environnement, sans redéploiement de code :
+GEMINI_DEFAULT_MODEL et GEMINI_LITE_MODEL.
+"""
+
+import os
+from typing import Optional
+
+# Modèle Flash stable actuel (usage général : conseils, analyses, lettres, score)
+GEMINI_DEFAULT_MODEL = os.environ.get("GEMINI_DEFAULT_MODEL", "gemini-3.8-flash").strip()
+# Modèle économique (variante « lite »)
+GEMINI_LITE_MODEL = os.environ.get("GEMINI_LITE_MODEL", "gemini-3.5-flash-lite").strip()
+
+# Identifiants arrêtés par Google ou à accès restreint
+RETIRED_GEMINI_MODELS = {
+    "gemini-pro", "gemini-1.0-pro",
+    "gemini-1.5-flash", "gemini-1.5-flash-001", "gemini-1.5-flash-002", "gemini-1.5-flash-8b",
+    "gemini-1.5-pro", "gemini-1.5-pro-001", "gemini-1.5-pro-002",
+    "gemini-2.0-flash", "gemini-2.0-flash-001", "gemini-2.0-flash-lite", "gemini-2.0-flash-lite-001",
+}
+
+
+class EmptyAIResponseError(Exception):
+    """Le fournisseur IA n'a renvoyé aucun texte (réponse vide, blocage de sécurité...).
+    Une réponse vide n'est jamais enregistrée comme une génération réussie."""
+
+    def __init__(self, provider: str = ""):
+        super().__init__(f"Réponse vide du fournisseur IA{f' ({provider})' if provider else ''}")
+        self.provider = provider
+
+
+def require_ai_text(text, provider: str = "") -> str:
+    """Retourne le texte s'il est non vide, sinon lève EmptyAIResponseError."""
+    if not isinstance(text, str) or not text.strip():
+        raise EmptyAIResponseError(provider)
+    return text
+
+
+def resolve_gemini_model(model: Optional[str]) -> str:
+    """Modèle à appeler : celui demandé s'il est actuel, sinon un remplaçant équivalent."""
+    name = (model or "").strip()
+    if not name:
+        return GEMINI_DEFAULT_MODEL
+    if name.lower() in RETIRED_GEMINI_MODELS:
+        return GEMINI_LITE_MODEL if "lite" in name.lower() or "8b" in name.lower() else GEMINI_DEFAULT_MODEL
+    return name
