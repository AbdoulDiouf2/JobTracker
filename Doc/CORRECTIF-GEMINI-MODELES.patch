+"""
+Correctif Gemini (hors Lot 2) : une réponse IA vide n'est JAMAIS enregistrée comme une
+génération réussie (lettre de motivation, historique du conseiller et du chatbot).
+Tests hors ligne : faux clients SDK, aucune clé réelle, MongoDB éphémère pour les routes.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+
+import google.genai
+import groq
+import openai
+from google.genai import types as gtypes
+from groq.types.chat import ChatCompletion as GroqChatCompletion
+from openai.types.chat import ChatCompletion as OpenAIChatCompletion
+
+from utils.ai_models import EmptyAIResponseError, require_ai_text
+
+pytestmark = pytest.mark.anyio
+
+AI_KEY_VARS = ("GROQ_API_KEY", "OPENAI_API_KEY", "EMERGENT_LLM_KEY", "GOOGLE_API_KEY",
+               "GEMINI_API_KEY", "GOOGLE_AI_API_KEY")
+LETTER = "Madame, Monsieur, je souhaite rejoindre votre équipe."
+
+
+def chat_completion(cls, text):
+    return cls.model_validate({
+        "id": "offline", "object": "chat.completion", "created": 0, "model": "offline",
+        "choices": [{"index": 0, "finish_reason": "stop", "message": {"role": "assistant", "content": text}}],
+    })
+
+
+def genai_response(text):
+    if text is None:
+        return gtypes.GenerateContentResponse.model_validate({"candidates": []})
+    return gtypes.GenerateContentResponse.model_validate(
+        {"candidates": [{"content": {"role": "model", "parts": [{"text": text}]}}]})
+
+
+@pytest.fixture
+def ai(monkeypatch):
+    """Faux clients des 3 SDK ; `state.reply` fixe la réponse renvoyée."""
+    for var in AI_KEY_VARS:
+        monkeypatch.delenv(var, raising=False)
+    state = SimpleNamespace(reply=LETTER, calls=0)
+
+    def chat_client(response_cls):
+        class Fake:
+            def __init__(self, api_key=None, **kwargs):
+                def create(**kw):
+                    state.calls += 1
+                    return chat_completion(response_cls, state.reply)
+                self.chat = SimpleNamespace(completions=SimpleNamespace(create=create))
+        return Fake
+
+    class FakeGenai:
+        def __init__(self, api_key=None, **kwargs):
+            def generate_content(**kw):
+                state.calls += 1
+                return genai_response(state.reply)
+            self.models = SimpleNamespace(generate_content=generate_content)
+
+    monkeypatch.setattr(openai, "OpenAI", chat_client(OpenAIChatCompletion))
+    monkeypatch.setattr(groq, "Groq", chat_client(GroqChatCompletion))
+    monkeypatch.setattr(google.genai, "Client", FakeGenai)
+    import routes.ai as ai_routes
+    monkeypatch.setattr(ai_routes, "OpenAI", openai.OpenAI, raising=False)
+    monkeypatch.setattr(ai_routes, "Groq", groq.Groq, raising=False)
+    monkeypatch.setattr(ai_routes, "USE_EMERGENT", False)
+    return state
+
+
+# ============================================
+# Garde-fou central
+# ============================================
+
+@pytest.mark.parametrize("value", [None, "", "   ", "\n\t", 42, {"text": "x"}])
+def test_require_ai_text_rejects_empty_or_non_text(value):
+    with pytest.raises(EmptyAIResponseError):
+        require_ai_text(value, "google")
+
+
+def test_require_ai_text_returns_text():
+    assert require_ai_text("  Bonjour ", "groq") == "  Bonjour "
+
+
+@pytest.mark.parametrize("provider", ["openai", "google", "groq"])
+@pytest.mark.parametrize("reply", [None, "", "   "])
+async def test_call_ai_never_returns_an_empty_response(ai, provider, reply):
+    from routes.ai import call_ai
+    if reply is None and provider != "google":
+        reply = ""  # OpenAI et Groq renvoient au pire une chaîne vide
+    ai.reply = reply
+    with pytest.raises(EmptyAIResponseError):
+        await call_ai("k", provider, "modele", "S", "U")
+
+
+async def test_call_ai_returns_non_empty_text(ai):
+    from routes.ai import call_ai
+    ai.reply = "Conseil"
+    assert await call_ai("k", "google", "gemini-1.5-flash", "S", "U") == "Conseil"
+
+
+# ============================================
+# Lettre de motivation : rien n'est enregistré si la réponse est vide
+# ============================================
+
+@pytest.fixture
+def no_cloudinary(monkeypatch):
+    import routes.documents as docs
+
+    async def fake_upload(*args, **kwargs):
+        return None
+    monkeypatch.setattr(docs, "upload_cover_letter_to_cloudinary", fake_upload)
+
+
+ENV_KEY = {"groq": "GROQ_API_KEY", "openai": "OPENAI_API_KEY", "google": "GOOGLE_API_KEY"}
+
+
+async def generate_letter(api):
+    return await api.post("/api/documents/generate-cover-letter-ai",
+                          params={"entreprise": "Orange", "poste": "Data Engineer"}, headers=api.headers_for("a"))
+
+
+@pytest.mark.parametrize("provider, reply", [
+    ("google", None), ("google", ""), ("google", "   "), ("openai", ""), ("groq", "  \n "),
+])
+async def test_empty_cover_letter_is_not_saved(api, db, ai, monkeypatch, no_cloudinary, provider, reply):
+    monkeypatch.setenv(ENV_KEY[provider], "cle-test")
+    ai.reply = reply
+    r = await generate_letter(api)
+    assert r.status_code == 502
+    assert "aucune lettre n'a été enregistrée" in r.json()["detail"]
+    assert await db.generated_cover_letters.count_documents({}) == 0
+
+
+@pytest.mark.parametrize("provider", ["google", "openai", "groq"])
+async def test_valid_cover_letter_is_saved(api, db, ai, monkeypatch, no_cloudinary, provider):
+    monkeypatch.setenv(ENV_KEY[provider], "cle-test")
+    ai.reply = LETTER
+    r = await generate_letter(api)
+    assert r.status_code == 200 and r.json()["content"] == LETTER
+    saved = await db.generated_cover_letters.find_one({"user_id": api.users["a"]})
+    assert saved["content"] == LETTER
+
+
+# ============================================
+# Conseiller carrière et chatbot : pas d'échange vide dans l'historique
+# ============================================
+
+async def give_google_key(db, api):
+    await db.users.update_one({"id": api.users["a"]}, {"$set": {"google_ai_key": "cle-test"}})
+
+
+async def test_empty_career_advice_is_not_saved(api, db, ai):
+    await give_google_key(db, api)
+    ai.reply = None
+    r = await api.post("/api/ai/career-advisor", json={"question": "Comment progresser ?", "model_provider": "google"},
+                       headers=api.headers_for("a"))
+    assert r.status_code == 500 and "Réponse vide" in r.json()["detail"]
+    assert await db.chat_history.count_documents({}) == 0
+
+
+async def test_valid_career_advice_is_saved(api, db, ai):
+    await give_google_key(db, api)
+    ai.reply = "Relancez vos candidatures."
+    r = await api.post("/api/ai/career-advisor", json={"question": "Comment progresser ?", "model_provider": "google"},
+                       headers=api.headers_for("a"))
+    assert r.status_code == 200 and r.json()["advice"] == "Relancez vos candidatures."
+    assert await db.chat_history.count_documents({}) == 1
+
+
+async def test_empty_chatbot_reply_is_not_saved(api, db, ai):
+    await give_google_key(db, api)
+    ai.reply = "   "
+    r = await api.post("/api/ai/chatbot", json={"message": "Bonjour", "model_provider": "google"},
+                       headers=api.headers_for("a"))
+    assert r.status_code == 500
+    assert await db.chat_history.count_documents({}) == 0
