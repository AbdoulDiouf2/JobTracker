+"""
+Correctif Gemini (hors Lot 2) : plus aucun modèle Gemini arrêté n'est appelé.
+Tests hors ligne : aucun réseau, aucune clé réelle.
+"""
+
+import os
+import re
+from types import SimpleNamespace
+
+import pytest
+
+import google.genai
+from google.genai import types as gtypes
+
+from utils.ai_models import (
+    GEMINI_DEFAULT_MODEL, GEMINI_LITE_MODEL, RETIRED_GEMINI_MODELS, resolve_gemini_model,
+)
+
+BACKEND_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+ROUTES = ["routes/ai.py", "routes/data_import.py", "routes/documents.py", "routes/tracking.py",
+          "routes/statistics.py"]
+
+
+def test_defaults_are_current_models():
+    assert GEMINI_DEFAULT_MODEL == "gemini-3.8-flash"
+    assert GEMINI_LITE_MODEL == "gemini-3.5-flash-lite"
+    assert GEMINI_DEFAULT_MODEL not in RETIRED_GEMINI_MODELS and GEMINI_LITE_MODEL not in RETIRED_GEMINI_MODELS
+
+
+@pytest.mark.parametrize("requested, expected", [
+    ("gemini-1.5-flash", "gemini-3.8-flash"),
+    ("gemini-1.5-pro", "gemini-3.8-flash"),
+    ("Gemini-1.5-Flash", "gemini-3.8-flash"),
+    ("gemini-2.0-flash", "gemini-3.8-flash"),
+    ("gemini-2.0-flash-lite", "gemini-3.5-flash-lite"),
+    ("gemini-1.5-flash-8b", "gemini-3.5-flash-lite"),
+    (None, "gemini-3.8-flash"),
+    ("", "gemini-3.8-flash"),
+    ("gemini-3.6-flash", "gemini-3.6-flash"),       # modèle actuel : respecté
+    ("gemini-3.1-pro-preview", "gemini-3.1-pro-preview"),
+])
+def test_resolve_gemini_model(requested, expected):
+    assert resolve_gemini_model(requested) == expected
+
+
+@pytest.mark.parametrize("path", ROUTES)
+def test_no_hardcoded_gemini_model_in_routes(path):
+    source = open(os.path.join(BACKEND_DIR, path), encoding="utf-8").read()
+    assert re.findall(r"gemini-\d", source) == []
+
+
+def test_catalog_lists_only_current_models():
+    from routes.ai import AI_MODELS
+    ids = [m["model_id"] for m in AI_MODELS["google"]]
+    assert ids == [GEMINI_DEFAULT_MODEL, GEMINI_LITE_MODEL]
+    assert not set(ids) & RETIRED_GEMINI_MODELS
+
+
+@pytest.fixture
+def fake_genai(monkeypatch):
+    calls = []
+
+    class FakeClient:
+        def __init__(self, api_key=None, **kwargs):
+            def generate_content(**kw):
+                calls.append(kw)
+                return gtypes.GenerateContentResponse.model_validate(
+                    {"candidates": [{"content": {"role": "model", "parts": [{"text": "ok"}]}}]})
+            self.models = SimpleNamespace(generate_content=generate_content)
+
+    monkeypatch.setattr(google.genai, "Client", FakeClient)
+    import routes.ai as ai_routes
+    monkeypatch.setattr(ai_routes, "USE_EMERGENT", False)
+    return calls
+
+
+@pytest.mark.anyio
+@pytest.mark.parametrize("requested", ["gemini-1.5-flash", "gemini-2.0-flash"])
+async def test_call_google_never_sends_a_retired_model(fake_genai, requested):
+    from routes.ai import call_google
+    assert await call_google("k", requested, "S", "U") == "ok"
+    assert fake_genai[-1]["model"] == GEMINI_DEFAULT_MODEL
+
+
+@pytest.mark.anyio
+async def test_cv_analysis_with_google_uses_current_model(fake_genai):
+    from routes.data_import import analyze_cv_with_google
+    assert await analyze_cv_with_google("k", "CV", "ctx") == "ok"
+    assert fake_genai[-1]["model"] == GEMINI_DEFAULT_MODEL
+
+
+def test_models_overridable_by_environment():
+    """Surcharge par variables d'environnement, vérifiée dans un processus neuf : recharger
+    le module dans le processus de test recréerait ses classes et fausserait les autres tests."""
+    import subprocess
+    import sys
+    code = ("from utils.ai_models import GEMINI_DEFAULT_MODEL as d, GEMINI_LITE_MODEL as l, "
