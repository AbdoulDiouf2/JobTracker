# JobTracker Frontend (Create React App)
# Copier vers .env pour le développement local; ne jamais committer les fichiers .env.
# En production auto-hébergée, cette variable est injectée à la construction de l'image.
REACT_APP_BACKEND_URL=http://localhost:8001

# Pour un build de production JobTracker, utiliser :
# REACT_APP_BACKEND_URL=https://jobtracker.maadec.com
# Réglages CRA de développement facultatifs; généralement inutiles en production.
# WDS_SOCKET_PORT=
# ENABLE_HEALTH_CHECK=
